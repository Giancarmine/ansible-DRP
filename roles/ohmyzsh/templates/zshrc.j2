# Managed by ansible-DRP. The previous file is kept next to this one as a
# timestamped backup.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search
)

# Oh My Zsh and its plugins are pinned by Ansible. Do not self-update away
# from those versions; bump the pins in group_vars/all.yml instead.
zstyle ':omz:update' mode disabled

source "$ZSH/oh-my-zsh.sh"

# The k8s_tools role generates one native zsh completion file per tool at
# provision time. Loading them after Oh My Zsh means compinit has already run,
# and no tool binary is executed when a new shell starts. The (N) qualifier
# skips the loop when the directory does not exist or is empty.
completion_dir="{{ home }}/.config/ansible-drp/completions.d"
if [ -d "$completion_dir" ]; then
  for completion in "$completion_dir"/*.zsh(N); do
    source "$completion"
  done
fi

export PATH="$HOME/bin:/usr/local/bin:$PATH"
export HIST_STAMPS="yyyy-mm-dd HH:MM:ss"
export HISTSIZE=10000
export SAVEHIST=10000

# Arrow keys search the history for the already-typed prefix.
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
